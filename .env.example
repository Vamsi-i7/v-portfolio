# ============================================================
# V Portfolio — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local to version control.
# ============================================================

# ----- SUPABASE (Public — safe to expose in frontend) ------
# Found in: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ----- SUPABASE (Private — server-side ONLY, NOT VITE_ prefixed) -----
# Used ONLY in Vercel Edge Functions (api/cron/*.ts, api/contact.ts)
# NEVER prefix with VITE_ — this would expose it to the browser bundle
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ----- GITHUB (Private — server-side ONLY) -----
# Create at: https://github.com/settings/tokens
# Required scopes: read:user, repo (for star counts)
# Used by: api/cron/sync-github.ts cron job
GITHUB_PAT=your-github-personal-access-token-here

# ----- RESEND (Private — server-side ONLY) -----
# Create at: https://resend.com (free tier: 100 emails/day)
# Used by: api/contact.ts Edge Function
RESEND_API_KEY=re_your-resend-api-key-here

# ----- CRON SECURITY -----
# A random secret string used to authenticate Vercel cron job requests
# Generate with: openssl rand -base64 32
CRON_SECRET=your-cron-secret-here

# ----- SITE URL (for SEO / canonical URLs) -----
# Set to your production domain once connected (e.g., https://yourname.dev)
VITE_SITE_URL=http://localhost:5173

# ----- ANALYTICS (Optional — for recruiter tracking) -----
# Get these from your Umami dashboard (Cloud or Self-hosted)
VITE_UMAMI_WEBSITE_ID=your-umami-website-id-here
VITE_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
